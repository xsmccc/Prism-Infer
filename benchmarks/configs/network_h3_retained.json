{
  "enforce_eager": false,
  "execution_backend": "compile_graph",
  "decode_compile_region": "stateless",
  "decode_compile_mode": "max-autotune-no-cudagraphs",
  "decode_compile_emulate_precision_casts": true,
  "decode_compile_force_same_precision": true,
  "allow_unsafe_decode_compile": true,
  "compression_mode": "visual_compact_scaled_fp8",
  "tensor_parallel_size": 1,
  "max_model_len": 4096,
  "max_num_batched_tokens": 4096,
  "max_num_seqs": 8,
  "gpu_memory_utilization": 0.9,
  "num_kvcache_blocks": 220,
  "kvcache_block_size": 256,
  "enable_chunked_prefill": true,
  "max_chunk_size": 2048,
  "enable_prefix_caching": false,
  "max_queue_size": null,
  "max_consecutive_prefill_batches": 1,
  "visual_pruning_keep_ratio": 0.6,
  "visual_pruning_min_keep_tokens": 768,
  "visual_pruning_video_min_keep_tokens": 256,
  "visual_pruning_strategy": "uniform",
  "visual_pruning_attention_last_n_layers": 1,
  "logits_precision": "selective_fp32",
  "mlp_projection_mode": "packed",
  "paged_decode_block_n": 256,
  "enable_fused_qk_rmsnorm": true,
  "enable_fused_qk_mrope": true,
  "enable_fused_add_rmsnorm": true,
  "enable_packed_kv_projection": true,
  "enable_vision_tensor_cudagraph": false,
  "vision_attention_backend": "sdpa"
}
